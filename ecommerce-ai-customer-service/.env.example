# ============================================
# 电商智能客服 环境变量示例
# 使用方式：复制本文件为 .env 并按需修改
#   cp .env.example .env
# ============================================

# ---- 应用基础 ----
APP_NAME=Ecommerce AI Customer Service
APP_ENV=development
DEBUG=false
VERSION=0.7.0

# ---- 服务监听 ----
HOST=127.0.0.1
PORT=8000

# ---- CORS（逗号分隔）----
# 生产环境请改为实际 HTTPS 前端域名；不要加入 null 或不受控来源。
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ---- 数据目录 ----
DATA_DIR=data

# ============================================
# 会话日志（SQLite）
# ============================================
# 是否把每轮对话持久化到 SQLite（便于管理接口查看历史 / 复盘）
LOG_STORE_ENABLED=true
# SQLite 文件路径（相对路径以项目根目录为基准）
LOG_DB_PATH=data/app.db

# ============================================
# 管理接口鉴权
# ============================================
# 管理接口默认拒绝；生产环境必须设置为至少 32 字符的随机值。
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# ============================================
# 用户鉴权
# ============================================
# 生产环境必须配置为至少 32 字符的随机值，且 AUTH_ENABLED 必须为 true。
AUTH_ENABLED=true
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=86400

# ---- 音频上传限制 ----
# 单次上传最大字节数（默认 10 MB）
ASR_MAX_UPLOAD_BYTES=10485760
ASR_STREAM_MAX_BYTES=10485760
ASR_STREAM_MAX_CONNECTIONS=2

# ============================================
# 限流（内存滑动窗口，按客户端 IP）
# ============================================
RATE_LIMIT_ENABLED=true
# 每个窗口允许的请求数
RATE_LIMIT_REQUESTS=60
# 窗口长度（秒）
RATE_LIMIT_WINDOW=60
# 登录接口采用独立、更严格的限流窗口，降低撞库风险
LOGIN_RATE_LIMIT_ENABLED=false
LOGIN_RATE_LIMIT_REQUESTS=5
LOGIN_RATE_LIMIT_WINDOW=900
# 免限流路径前缀（逗号分隔）
RATE_LIMIT_EXEMPT_PATHS=/health,/docs,/redoc,/openapi.json,/ui,/static
# 是否信任 X-Forwarded-For（仅部署在可信反向代理后才设为 true，否则可被伪造绕过限流）
TRUST_FORWARDED_FOR=false

# ============================================
# 大模型 / OpenAI 兼容接口
# 支持：官方 OpenAI / 本地 Ollama / 第三方兼容服务
# ============================================

# API Key（Ollama 本地可随便填，如 ollama）
OPENAI_API_KEY=

# Base URL：
#   官方 OpenAI        https://api.openai.com/v1
#   本地 Ollama        http://localhost:11434/v1
#   DeepSeek           https://api.deepseek.com/v1
#   通义千问(DashScope) https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名：
#   gpt-4o-mini / deepseek-chat / qwen2.5:7b ...
MODEL_NAME=gpt-4o-mini

# ---- 本地 Ollama（客服界面切换到“本地 Ollama”时使用） ----
# 不要在此填写 DeepSeek Key；Ollama 在本机默认不需要真实 API Key。
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL_NAME=qwen2.5:7b-instruct-q4_K_M

# 模型调用参数
TEMPERATURE=0.7
MAX_TOKENS=1024
REQUEST_TIMEOUT=60

# ============================================
# 知识库检索（RAG）
# ============================================
# 检索后端：tfidf（默认，轻量无依赖） / embedding（语义检索，需装依赖） / auto
RETRIEVER_BACKEND=tfidf
# embedding 后端使用的模型（仅 RETRIEVER_BACKEND=embedding/auto 时生效）
EMBEDDING_MODEL=shibing624/text2vec-base-chinese
# 检索返回的 FAQ 条数
FAQ_TOP_K=3
# 检索得分下限（低于该值视为未命中知识库）
FAQ_MIN_SCORE=0.15

# ---- 意图识别 ----
# 规则未命中时是否调用大模型做兜底分类
INTENT_USE_LLM=true

# ---- 日志 ----
LOG_LEVEL=INFO
